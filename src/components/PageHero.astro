---
const { eyebrow, title, lead } = Astro.props;
---
<section class="phero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .phero { padding: clamp(56px, 8vw, 104px) 0; text-align: center; background: radial-gradient(900px 400px at 50% 0%, var(--sage-soft), transparent 70%), var(--ivory-warm); }
  .phero p { max-width: 640px; margin: 0 auto; font-size: 1.15rem; color: var(--muted); }
</style>
